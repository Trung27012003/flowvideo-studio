# Optional: script, speech, transcription and image generation. Never commit real credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_IMAGE_MODEL=gpt-image-1
# Accepted image requests in a rolling 24-hour window, across all projects (1-100). Not a money budget.
IMAGE_DAILY_LIMIT=10

# Optional Google video generation (billed by provider). Backend environment only.
GEMINI_API_KEY=
GEMINI_VIDEO_MODEL=gemini-omni-1.2-flash
# Accepted video requests in rolling 24 hours; not a money budget.
VIDEO_DAILY_LIMIT=5

# Per-scene TTS reservations from production workflows only, rolling 24 hours (1-100).
WORKFLOW_TTS_DAILY_LIMIT=20

# Optional structured story proposals; model must support Chat Completions Structured Outputs.
OPENAI_STORY_MODEL=gpt-4o-mini
# Accepted AI story-plan requests in rolling 24 hours, excluding manual JSON imports (1-100).
STORY_DAILY_LIMIT=10
